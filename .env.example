# copy this to .env and fill in whatever you want. all of it is optional —
# with an empty file ava runs entirely on the mac.

# ElevenLabs — a cloud voice. empty means the local engine (see config.json).
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# Mistral — cloud transcription (voxtral) and the intent router.
# empty means whisper large-v3-turbo on the mac's gpu, which is faster anyway.
MISTRAL_API_KEY=

# Gmail — "lis mes mails" reads the unread out loud over imap (read-only).
# app password from https://myaccount.google.com/apppasswords (needs 2fa).
# empty means ava just opens gmail in the browser.
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Google Calendar — you can put these here instead of the settings panel.
# create your own oauth client (desktop app) at console.cloud.google.com.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- knobs you rarely need ---------------------------------------------------
# AVA_DEBUG=1          print the measured level and threshold on every peak
# AVA_PAUSED=1         start without listening
# AVA_GREET=1          play the morning ritual at launch
# AVA_OVERLAY=0        run without the orb window
# AVA_HOME=/some/path  keep config, tokens, caches and models somewhere else
# AVA_WAKE_GAIN=0      disable the pre-vosk gain if you have a loud mic
