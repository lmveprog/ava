# copy this file to .env and fill in what you need. everything here is optional.

# ElevenLabs — natural voice. if left empty, Ava uses the macOS system voice.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# Mistral / Voxtral — cloud transcription. if left empty, Ava uses local Whisper.
MISTRAL_API_KEY=
